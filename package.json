{
  "name": "sandystravelingcamera",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy",
    "typegen": "sanity schema extract && sanity typegen generate",
    "map:generate": "node scripts/generate-world-map.mts",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "seed:reset": "sanity exec scripts/seed.ts --with-user-token -- --reset"
  },
  "keywords": [
    "sanity",
    "photography",
    "nextjs"
  ],
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.14.1",
    "next": "^16.3.5",
    "next-sanity": "^13.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.14.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.14",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.8",
    "world-atlas": "^2.0.2"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
